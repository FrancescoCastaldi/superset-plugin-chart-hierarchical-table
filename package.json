{
  "name": "superset-plugin-chart-hierarchical-table",
  "version": "0.10.5",
  "description": "Apache Superset 6.1.0 Hierarchical Table & Matrix Grid Chart Plugin",
  "homepage": "https://francescocastaldi.github.io/superset-plugin-chart-hierarchical-table/",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancescoCastaldi/superset-plugin-chart-hierarchical-table.git"
  },
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "npm --prefix dev-studio run dev",
    "dev:build": "npm --prefix dev-studio run build",
    "build": "(tsc --project tsconfig.json --emitDeclarationOnly || node ../../node_modules/typescript/lib/tsc.js --project tsconfig.json --emitDeclarationOnly || npx tsc --project tsconfig.json --emitDeclarationOnly) && npm run build:esm",
    "build:esm": "node scripts/build.mjs",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "test": "node ./node_modules/jest/bin/jest.js --preset=ts-jest || node ../../node_modules/jest/bin/jest.js --preset=ts-jest",
    "test:watch": "node ./node_modules/jest/bin/jest.js --preset=ts-jest --watch || node ../../node_modules/jest/bin/jest.js --preset=ts-jest --watch"
  },
  "keywords": [
    "superset",
    "apache-superset",
    "superset-plugin",
    "superset-chart",
    "superset-6",
    "hierarchical-table",
    "tree-table",
    "pivot-grid",
    "hierarchy"
  ],
  "author": "Francesco Castaldi",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@superset-ui/chart-controls": "*",
    "@superset-ui/core": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@superset-ui/chart-controls": {
      "optional": true
    }
  },
  "dependencies": {
    "classnames": "^2.3.2"
  },
  "devDependencies": {
    "@superset-ui/core": "^0.20.4",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
